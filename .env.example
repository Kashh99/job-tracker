NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Email import
# Server-only Supabase secret key (Project Settings -> API Keys). Used only by
# the inbound email webhook, which has no user session.
SUPABASE_SECRET_KEY=your-secret-key
# Inbound address from your email provider, e.g. abc123@inbound.postmarkapp.com.
# Each user's forwarding address is this with "+<inbox token>" added.
INBOUND_EMAIL_ADDRESS=
# Only needed outside Vercel; on Vercel the AI Gateway authenticates with OIDC.
AI_GATEWAY_API_KEY=
